{
  "manifest_version": 3,
  "name": "Screen Shoot AI",
  "version": "1.0",
  "description": "Chụp vùng màn hình và gửi cho AI (Gemini) phân tích.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://generativelanguage.googleapis.com/*"
  ],
  "icons": {
    "16":  "image/icon16.png",
    "32":  "image/icon32.png",
    "48":  "image/icon48.png",
    "128": "image/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16":  "image/icon16.png",
      "32":  "image/icon32.png",
      "48":  "image/icon48.png",
      "128": "image/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content/content.css"],
      "js": ["content/content.js"]
    }
  ],
  "commands": {
    "capture_region": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Kích hoạt chọn vùng ảnh"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["image/images.jfif"],
      "matches": ["<all_urls>"]
    }
  ]
}
